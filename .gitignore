# Full system images — too large for git; they ship as Release assets.
*.img.zst
*.img.xz
dragon_q6a_*.img
userdata*.img
metadata*.img
super.img

# Build-staged duplicates (regenerated by gensdimg-uefi.sh from prebuilt/ + ramdisk)
device/glodroid/dragon_q6a/esp/Android/Image
device/glodroid/dragon_q6a/esp/Android/ramdisk.img
device/glodroid/dragon_q6a/esp/Android/*.dtb

# AOSP/GloDroid build output
out/
*.o
*.zip

# Windows alternate-data-stream metadata
*:Zone.Identifier
*.Zone.Identifier

# Editor / OS noise
.DS_Store
*.swp

# Third-party APKs are fetched, not committed (see scripts/fetch-lawnchair.sh)
*.apk
# Exception: RebootRecovery is ours (12 KB) and apps/RebootRecovery/Android.bp references
# it as a prebuilt, so the tree does not build without it.
!device/glodroid/dragon_q6a/apps/RebootRecovery/RebootRecovery.apk
